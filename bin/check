#!/bin/sh

set -eu

ALLOW_DIRTY=0
MDBOOK_VERSION=0.5.3
RELEASE_MODE=0
RUN_SEMVER=0
RUN_VULKAN=1

for arg in "$@"; do
    case "$arg" in
        --allow-dirty)
            ALLOW_DIRTY=1
            ;;
        --release)
            RELEASE_MODE=1
            ;;
        --semver)
            RUN_SEMVER=1
            ;;
        --skip-vulkan)
            RUN_VULKAN=0
            ;;
        *)
            printf 'unknown argument: %s\n' "$arg" >&2
            exit 2
            ;;
    esac
done

if [ "$RELEASE_MODE" -eq 1 ]; then
    PROFILE="--release"
else
    PROFILE=""
fi

fail() {
    printf '%s\n' "$1" >&2
    exit "${2-1}"
}

install_mdbook() {
    version=$(mdbook --version 2>/dev/null | awk '{print $2}' || true)

    if [ "$version" != "$MDBOOK_VERSION" ]; then
        run "install mdbook ${MDBOOK_VERSION}" cargo install --locked mdbook --version "$MDBOOK_VERSION"
    fi
}

run() {
    printf '==> %s\n' "$1"
    shift
    "$@"
}

if [ "$ALLOW_DIRTY" -ne 1 ]; then
    git diff --no-ext-diff --quiet || fail "uncommitted changes (pass --allow-dirty to skip this check)"
fi

# Rust code checks
run "format check" cargo fmt --all --check

for features in loaded,parking_lot loaded,parking_lot,checked; do
    run "workspace target check ($features)" env RUSTFLAGS="-D warnings" cargo check $PROFILE --all-targets --workspace --no-default-features --features "$features"
    run "workspace clippy ($features)" cargo clippy $PROFILE --all-targets --workspace --no-default-features --features "$features" -- -D warnings
    run "workspace tests ($features)" env RUSTFLAGS="-D warnings" cargo test $PROFILE --all-targets --workspace --no-default-features --features "$features"
done

# Workspace dev-dependencies can re-enable parking_lot; check std synchronization separately.
for features in loaded loaded,checked; do
    run "library check ($features)" env RUSTFLAGS="-D warnings" cargo check $PROFILE -p vk-graph --lib --no-default-features --features "$features"
done

if [ "$RUN_VULKAN" -eq 1 ]; then
    for features in loaded,parking_lot loaded,parking_lot,checked; do
        run "vulkan tests ($features)" env RUSTFLAGS="-D warnings" \
            VK_GRAPH_SKIP_VALIDATION_PARK=1 \
            cargo test $PROFILE --workspace --tests --no-default-features --features "$features" \
            -- --ignored --test-threads=1 --nocapture \
            --skip subpass_planning_benchmark --skip binding_metadata_benchmark
    done
fi

run "workspace doctests" env RUSTFLAGS="-D warnings" cargo test $PROFILE --workspace --doc
run "workspace docs" env RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps
run "guide hot doctests" env RUSTFLAGS="-D warnings" cargo test -p guide --features hot

# Build guide book
install_mdbook
run "guide build" mdbook build guide/

if [ "$RUN_SEMVER" -eq 1 ]; then
    # Check for semver breaking changes: if this fails you must update the crate version or fix the code
    run "semver check (vk-graph)" cargo semver-checks check-release -p vk-graph --default-features
    run "semver check (vk-graph-egui)" cargo semver-checks check-release -p vk-graph-egui
    run "semver check (vk-graph-fx)" cargo semver-checks check-release -p vk-graph-fx
    run "semver check (vk-graph-hot)" cargo semver-checks check-release -p vk-graph-hot
    run "semver check (vk-graph-imgui)" cargo semver-checks check-release -p vk-graph-imgui
    run "semver check (vk-graph-window)" cargo semver-checks check-release -p vk-graph-window
fi

printf 'OK\n'
